.bar-chart { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 17rpx 0; }
.bar-row { display: grid; grid-template-columns: 67rpx 1fr 38rpx; align-items: center; gap: 19rpx; font-size: 21rpx; margin: 25rpx 0; }
.bar-track { height: 13rpx; background: #F0F4F7; border-radius: 19rpx; overflow: hidden; }
.bar-fill { height: 100%; background: #ADC9DE; border-radius: 19rpx; }
.ranking-name { font-size: 25rpx; margin-bottom: 11rpx; }
