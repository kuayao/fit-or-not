<view class="page"><view wx:if="{{error}}" class="error" bindtap="onRetry">{{error}} · 点击重试</view>
  <view class="stats-grid"><view class="stat-card stat-card--accent"><view class="stat-value">{{totalCount}}</view><view class="stat-label">{{all ? '正常与归档' : '日常衣橱'}} · 件</view></view><view class="stat-card"><view class="stat-value">{{wornDays}}</view><view class="stat-label">已记录穿搭 · 天</view></view><view class="stat-card"><view class="stat-value">¥{{totalPrice}}</view><view class="stat-label">已知购入金额</view></view><view class="stat-card"><view class="stat-value">{{outfitCount}}</view><view class="stat-label">已保存搭配 · 套</view></view></view>
  <view class="form-hint">统计{{all ? '正常与归档' : '正常状态'}}衣物；{{pricedCount}}/{{totalCount}} 件填写价格。穿着按每件衣物的不同日期计数。</view><view class="segmented"><view class="segmented__option {{!all ? 'segmented__option--selected' : ''}}" data-value="{{false}}" bindtap="onScope">日常衣橱</view><view class="segmented__option {{all ? 'segmented__option--selected' : ''}}" data-value="{{true}}" bindtap="onScope">包含归档</view></view>
  <view class="section-head"><view class="section-title">衣橱的组成</view><text class="count-note">{{totalCount}} 件</text></view><view class="bar-chart"><view wx:for="{{categories}}" wx:key="name" class="bar-row"><text>{{item.name}}</text><view class="bar-track"><view class="bar-fill" style="width:{{item.width}}" /></view><text>{{item.count}}</text></view></view>
  <view class="section-head"><view class="section-title">{{mostWorn ? '那些常常陪伴你的衣物' : '给它们一个出场机会'}}</view></view>
  <view class="segmented"><view class="segmented__option {{!mostWorn ? 'segmented__option--selected' : ''}}" data-value="{{false}}" bindtap="onSort">少穿的衣物</view><view class="segmented__option {{mostWorn ? 'segmented__option--selected' : ''}}" data-value="{{true}}" bindtap="onSort">常穿的衣物</view></view>
  <view wx:for="{{clothes}}" wx:key="id" class="row list-item" data-id="{{item.id}}" bindtap="onClothing"><image class="thumb" src="{{item.imageUrl}}" data-url="{{item.imageUrl}}" binderror="onImageError" mode="aspectFit" /><view class="grow"><view class="ranking-name">{{item.name}}</view><view class="card-meta">{{item.wearCount ? '记录了 ' + item.wearCount + ' 个穿着日' : '尚未记录穿着'}} · {{item.cost}}</view></view><image class="icon icon--small" src="/assets/icons/chevron.svg" mode="aspectFit" /></view>
  <view wx:if="{{loading}}" class="state">正在计算…</view><view wx:elif="{{!totalCount && !error}}" class="state">添加衣物并记录穿着后，这里会慢慢丰富起来</view><view class="form-hint section">{{description}}</view></view>
