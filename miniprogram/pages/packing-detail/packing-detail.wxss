.packing-detail { min-height: 100vh; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); background: var(--muted-surface); }
.trip-header { padding: 16rpx 24rpx 24rpx; border-radius: var(--panel-radius); background: linear-gradient(125deg, var(--action), var(--bg)); border: 1px solid var(--line); }
.trip-header__top { display: flex; align-items: center; gap: 12rpx; }
.trip-header__status { display: inline-block; margin-top: 8rpx; padding: 4rpx 12rpx; border-radius: var(--choice-radius); background: var(--bg); font-size: 21rpx; color: var(--primary); }
.trip-header__icon { width: 36rpx; height: 36rpx; flex-shrink: 0; }
.trip-header__top .icon-button { width: 64rpx; min-width: 64rpx; max-width: 64rpx; height: 64rpx; }
.trip-header__name { flex: 1; min-width: 0; font-size: 32rpx; font-weight: 600; line-height: 1.45; overflow-wrap: anywhere; }
.trip-header__date { display: flex; align-items: center; gap: 10rpx; font-size: 23rpx; color: var(--muted); margin-top: 8rpx; }
.trip-header__date image { width: 28rpx; height: 28rpx; flex-shrink: 0; }
.trip-header__date text { min-width: 0; overflow-wrap: anywhere; }
.trip-progress { display: flex; align-items: center; gap: 18rpx; margin-top: 18rpx; }
.trip-progress__summary { flex-shrink: 0; font-size: 21rpx; color: var(--primary); }
.trip-progress__track { flex: 1; min-width: 0; height: 6rpx; background: var(--action-line); border-radius: var(--choice-radius); overflow: hidden; }
.trip-progress__fill { height: 100%; background: var(--accent); border-radius: var(--choice-radius); transition: width .18s ease; }
.trip-end-prompt { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 18rpx 24rpx; color: var(--muted); font-size: 23rpx; }
.trip-end-prompt button { margin: 0; padding: 8rpx 0; background: transparent; font-size: 23rpx; line-height: 1.5; color: var(--primary); }
.trip-end-prompt button::after { border: 0; }
.packing-items__heading { position: sticky; top: 0; z-index: 2; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 18rpx; padding: 12rpx 0; background: var(--muted-surface); }
.packing-items__title { display: flex; align-items: baseline; flex-wrap: wrap; gap: 12rpx; min-width: 0; font-size: 27rpx; font-weight: 500; }
.packing-items__count { font-size: 22rpx; font-weight: 400; color: var(--muted); }
button.packing-items__add { display: flex; align-items: center; justify-content: center; flex-shrink: 0; gap: 8rpx; box-sizing: border-box; width: auto; min-width: 0; max-width: none; min-height: var(--touch-height); margin: 0; padding: 14rpx 20rpx; border: 1px solid var(--action-line); border-radius: var(--choice-radius); background: var(--bg); color: var(--primary); font-size: 25rpx; font-weight: 500; line-height: 1.5; }
.packing-items__add::after { border: 0; }
.packing-items__add image { width: 28rpx; height: 28rpx; }
button.packing-items__add--pressed { background: var(--pressed); }
button.packing-items__add[disabled] { color: var(--disabled-ink); opacity: .6; }
.packing-filters { margin-bottom: 24rpx; }
.packing-filters .segmented__option { font-size: 23rpx; padding: 14rpx 6rpx; }
.packing-group { border: 1px solid var(--line); background: var(--bg); border-radius: var(--radius); margin-bottom: 20rpx; overflow: hidden; }
.packing-group__header { display: flex; align-items: center; gap: 12rpx; min-height: 88rpx; padding: 18rpx 22rpx; box-sizing: border-box; }
.packing-group__name { flex: 1; min-width: 0; font-size: 27rpx; font-weight: 500; overflow-wrap: anywhere; }
.packing-group__count { flex-shrink: 0; font-size: 22rpx; color: var(--muted); }
.packing-group__count--ready { color: var(--primary); }
.packing-group__chevron { width: 26rpx; height: 26rpx; flex-shrink: 0; }
.packing-group__chevron--expanded { transform: rotate(90deg); }
.packing-group__items { padding: 0 18rpx; }
.packing-group .packing-item { border: 0; border-top: 1px solid var(--line); border-radius: 0; padding: 18rpx 0; margin: 0; }
.packing-item { display: flex; align-items: center; gap: 22rpx; background: var(--bg); border: 1px solid var(--line); border-radius: var(--radius); padding: 18rpx; margin-bottom: 16rpx; }
.packing-item--packed { border-color: var(--action-line); }
.packing-item__photo { width: 112rpx; height: 128rpx; border-radius: var(--choice-radius); background: var(--photo); flex-shrink: 0; }
.packing-item__name { font-size: 27rpx; overflow-wrap: anywhere; }
.packing-item__status { font-size: 22rpx; color: var(--muted); margin-top: 8rpx; }
.packing-item--packed .packing-item__status { color: var(--primary); }
button.packing-item__remove { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10rpx; box-sizing: border-box; width: 128rpx; min-width: 0; height: 100%; margin: 0; padding: 16rpx; border: 1px solid var(--line); border-radius: var(--choice-radius); background: var(--muted-surface); color: var(--danger); font-size: 23rpx; line-height: 1.5; }
.packing-item__remove::after { border: 0; }
.packing-item__remove image { width: 32rpx; height: 32rpx; }
.check-control { width: 44rpx; height: 44rpx; border: 1px solid var(--action-line); border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: background-color .15s ease, border-color .15s ease; }
.check-control--checked { background: var(--primary); border-color: var(--primary); }
.check-icon { filter: brightness(0) invert(1); width: 28rpx; height: 28rpx; }
.trip-empty { display: flex; align-items: center; flex-direction: column; padding: 80rpx 16rpx; text-align: center; }
.trip-empty__icon { display: flex; align-items: center; justify-content: center; width: 128rpx; height: 128rpx; background: var(--action); border-radius: 50%; margin-bottom: 24rpx; }
.trip-empty__icon image { width: 64rpx; height: 64rpx; }
.trip-empty__title { font-size: 30rpx; font-weight: 500; }
.trip-empty__copy { font-size: 23rpx; color: var(--muted); margin-top: 12rpx; }
.trip-menu { display: flex; flex-direction: column; gap: 14rpx; padding: 4rpx 0 calc(8rpx + env(safe-area-inset-bottom)); }
.trip-menu__group { overflow: hidden; background: var(--muted-surface); border-radius: var(--choice-radius); }
button.trip-menu__action { display: flex; align-items: center; gap: 18rpx; box-sizing: border-box; width: 100%; min-width: 0; max-width: none; min-height: 100rpx; margin: 0; padding: 18rpx 22rpx; background: var(--muted-surface); border: 0; border-radius: var(--choice-radius); color: var(--ink); font-size: 28rpx; font-weight: 400; line-height: 1.5; text-align: left; }
.trip-menu__action::after { border: 0; }
.trip-menu__group .trip-menu__action { border-radius: 0; }
.trip-menu__group .trip-menu__action + .trip-menu__action { border-top: 1px solid var(--line); }
.trip-menu__icon { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 60rpx; height: 60rpx; border-radius: var(--sheet-option-radius); background: var(--bg); }
.trip-menu__icon image { width: 32rpx; height: 32rpx; }
.trip-menu__label { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.trip-menu__arrow { width: 26rpx; height: 26rpx; flex-shrink: 0; opacity: .6; }
button.trip-menu__action--edit { background: var(--soft); color: var(--primary); font-weight: 500; }
button.trip-menu__action--delete { margin-top: 4rpx; background: var(--bg); color: var(--danger); }
.trip-menu__action--delete .trip-menu__icon { background: var(--muted-surface); }
button.trip-menu__action--pressed { background: var(--pressed); }
button.trip-menu__action[disabled] { color: var(--disabled-ink); opacity: .6; }
.packing-picker { height: 100%; display: flex; flex-direction: column; min-height: 0; overflow: hidden; }
.picker-tabs { flex-shrink: 0; margin-bottom: 18rpx; }
.picker-search { display: flex; align-items: center; gap: 12rpx; flex-shrink: 0; min-height: 80rpx; padding-left: 18rpx; background: var(--muted-surface); border-radius: var(--choice-radius); }
.picker-icon { width: 28rpx; height: 28rpx; flex-shrink: 0; }
.picker-search__input { width: 0; flex: 1; min-width: 0; font-size: 25rpx; color: var(--ink); }
.picker-search__clear, .picker-search__submit, .picker-filter { display: flex; align-items: center; justify-content: center; gap: 8rpx; margin: 0; padding: 0; background: transparent; border: 0; border-radius: var(--choice-radius); line-height: 1.5; font-size: 23rpx; color: var(--muted); }
.picker-search__clear::after, .picker-search__submit::after, .picker-filter::after { border: 0; }
.picker-search__clear { width: 56rpx; height: 72rpx; flex-shrink: 0; }
.picker-search__clear image { width: 26rpx; height: 26rpx; }
.picker-search__submit { color: var(--primary); height: 80rpx; padding: 0 20rpx; flex-shrink: 0; }
.picker-tools { display: flex; justify-content: space-between; gap: 16rpx; padding: 12rpx 0; flex-shrink: 0; }
.picker-filter { min-height: 64rpx; padding: 0 14rpx; }
.picker-filter--active { background: var(--soft); color: var(--primary); }
.picker-filter__count { font-weight: 600; color: var(--primary); }
.picker-body { display: flex; flex: 1; min-height: 0; height: 0; overflow: hidden; gap: 18rpx; }
.picker-categories { width: 124rpx; height: 100%; flex-shrink: 0; background: var(--muted-surface); border-radius: var(--choice-radius); }
.picker-category { min-height: 88rpx; box-sizing: border-box; display: flex; align-items: center; justify-content: center; padding: 18rpx 10rpx; font-size: 24rpx; text-align: center; overflow-wrap: anywhere; border-left: 3px solid transparent; color: var(--muted); }
.picker-category--active { background: var(--soft); border-left-color: var(--primary); color: var(--primary); font-weight: 500; }
.picker-results { flex: 1; display: flex; flex-direction: column; min-width: 0; min-height: 0; }
.picker-subcategories { width: 100%; white-space: nowrap; flex-shrink: 0; margin-bottom: 10rpx; }
.picker-subcategory { display: inline-flex; align-items: center; min-height: 64rpx; box-sizing: border-box; padding: 10rpx 18rpx; margin-right: 10rpx; background: var(--muted-surface); color: var(--muted); font-size: 23rpx; border: 1px solid transparent; border-radius: var(--choice-radius); }
.picker-subcategory--active { background: var(--soft); color: var(--primary); border-color: var(--action-line); }
.picker-results__count { color: var(--muted); font-size: 21rpx; padding: 4rpx 0 14rpx; flex-shrink: 0; }
.picker-clothes { height: 0; flex: 1; min-height: 0; }
.picker-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; padding-bottom: 12rpx; }
.picker-clothing { min-width: 0; border: 1px solid var(--line); border-radius: var(--choice-radius); overflow: hidden; background: var(--muted-surface); }
.picker-clothing--selected { border-color: var(--primary); background: var(--soft); }
.picker-clothing__photo { position: relative; height: 196rpx; padding: 10rpx; box-sizing: border-box; }
.picker-clothing__photo > image { width: 100%; height: 100%; }
.picker-clothing__check { position: absolute; right: 10rpx; top: 10rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 34rpx; height: 34rpx; border-radius: 50%; border: 1px solid var(--action-line); background: var(--bg); }
.picker-clothing--selected .picker-clothing__check { background: var(--primary); border-color: var(--primary); }
.picker-clothing__check image { width: 24rpx; height: 24rpx; filter: brightness(0) invert(1); }
.picker-clothing__name { padding: 8rpx 12rpx 14rpx; font-size: 22rpx; line-height: 1.5; min-height: 66rpx; box-sizing: border-box; overflow-wrap: anywhere; }
.picker-clothing--included .picker-clothing__photo > image { opacity: .55; }
.picker-clothing__included { position: absolute; bottom: 6rpx; left: 8rpx; right: 8rpx; padding: 3rpx; text-align: center; background: var(--bg); color: var(--primary); font-size: 20rpx; border-radius: var(--choice-radius); }
.picker-feedback { color: var(--muted); text-align: center; font-size: 23rpx; padding: 28rpx 10rpx; overflow-wrap: anywhere; }
.picker-feedback--error { color: var(--danger); }
.picker-footer-error { color: var(--danger); font-size: 23rpx; margin-bottom: 12rpx; overflow-wrap: anywhere; }
.picker-outfits { flex: 1; height: 0; min-height: 0; }
.picker-outfit { display: flex; align-items: center; gap: 18rpx; padding: 24rpx; margin-bottom: 16rpx; background: var(--muted-surface); border-radius: var(--radius); }
.picker-outfit__name { font-size: 27rpx; overflow-wrap: anywhere; margin-bottom: 8rpx; }

.picker-sets { display: flex; flex-direction: column; flex: 1; min-height: 0; overflow: hidden; }
.picker-set-search { margin-bottom: 18rpx; }
.picker-set { display: flex; align-items: flex-start; gap: 18rpx; padding: 20rpx; margin-bottom: 16rpx; border: 1px solid var(--line); border-radius: var(--radius); background: var(--muted-surface); }
.picker-set__preview { display: grid; grid-template-columns: minmax(0, 1fr); box-sizing: border-box; flex-shrink: 0; width: 112rpx; height: 128rpx; padding: 6rpx; background: var(--bg); border-radius: var(--choice-radius); overflow: hidden; }
.picker-set__preview--grid { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: minmax(0, 1fr); gap: 4rpx; }
.picker-set__preview image { width: 100%; height: 100%; min-height: 0; }
.picker-set__info { flex: 1; min-width: 0; }
.picker-set__heading { display: flex; align-items: baseline; gap: 12rpx; margin-bottom: 12rpx; }
.picker-set__heading .card-meta { flex-shrink: 0; }
.picker-set__name { flex: 1; min-width: 0; font-size: 26rpx; line-height: 1.5; overflow-wrap: anywhere; }
.picker-set__member { display: flex; align-items: baseline; gap: 10rpx; margin-top: 8rpx; font-size: 22rpx; line-height: 1.5; }
.picker-set__member-name { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.picker-set__member-status { flex-shrink: 0; color: var(--muted); font-size: 20rpx; }
.picker-set__member-status--selected { color: var(--primary); }
button.picker-set__add { display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 100%; min-width: 0; min-height: var(--touch-height); margin: 18rpx 0 0; padding: 12rpx 18rpx; border: 1px solid var(--action-line); border-radius: var(--choice-radius); background: var(--bg); color: var(--primary); font-size: 24rpx; line-height: 1.5; }
.picker-set__add::after { border: 0; }
