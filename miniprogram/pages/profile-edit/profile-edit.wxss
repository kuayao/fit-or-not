.profile-edit { padding-bottom: calc(36rpx + env(safe-area-inset-bottom)); }
.profile-edit__avatar-field { display: flex; flex-direction: column; align-items: center; gap: 12rpx; margin: 54rpx 0; }
button.profile-edit__avatar-button { width: 144rpx; min-width: 144rpx; max-width: 144rpx; height: 144rpx; padding: 0; margin: 0; border: 0; border-radius: 50%; background: var(--soft); display: flex; align-items: center; justify-content: center; overflow: hidden; flex-shrink: 0; }
.profile-edit__avatar-button::after { border: 0; }
.profile-edit__avatar { width: 100%; height: 100%; border-radius: 50%; display: block; }
.profile-edit__avatar-label { font-size: 25rpx; color: var(--primary); }
.profile-edit__field-error { margin-top: 12rpx; color: var(--danger); font-size: 23rpx; }
