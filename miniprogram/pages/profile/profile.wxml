<view class="page page--tab"><view class="profile-head"><view class="avatar" bindtap="onEditProfile"><image wx:if="{{avatarUrl}}" class="avatar-photo" src="{{avatarUrl}}" data-url="{{avatarUrl}}" binderror="onImageError" mode="aspectFill" /><image wx:else class="icon" src="/assets/icons/user.svg" /></view><view class="grow" bindtap="onEditProfile"><view class="profile-title">{{nickname || '我'}}的日常</view></view></view><view wx:if="{{error}}" class="error" bindtap="onRetry">{{error}} · 点击重试</view>
  <view class="profile-metrics"><view><view class="profile-number">{{totalCount}}</view><view class="profile-label">件衣物</view></view><view><view class="profile-number">{{outfitCount}}</view><view class="profile-label">套搭配</view></view><view><view class="profile-number">{{wornDays}}</view><view class="profile-label">个穿着日</view></view></view>
  <view class="eyebrow">我的日常</view><view class="menu-list"><view wx:for="{{links}}" wx:key="page" wx:if="{{index < 3}}" class="menu-row" data-page="{{item.page}}" bindtap="onOpen" hover-class="control--pressed"><image class="icon" src="/assets/icons/{{item.icon}}.svg" mode="aspectFit" /><view class="grow">{{item.label}}</view><image class="icon icon--small" src="/assets/icons/chevron.svg" mode="aspectFit" /></view><view class="menu-row" bindtap="onArchive" hover-class="control--pressed"><image class="icon" src="/assets/icons/archive.svg" mode="aspectFit" /><view class="grow">归档衣物</view><image class="icon icon--small" src="/assets/icons/chevron.svg" mode="aspectFit" /></view></view>
  <view class="eyebrow section">一点穿搭灵感</view><view class="menu-list"><view wx:for="{{links}}" wx:key="page" wx:if="{{index >= 3 && index < 6}}" class="menu-row" data-page="{{item.page}}" bindtap="onOpen"><image class="icon" src="/assets/icons/{{item.icon}}.svg" mode="aspectFit" /><view class="grow">{{item.label}}</view><image class="icon icon--small" src="/assets/icons/chevron.svg" mode="aspectFit" /></view></view><view class="menu-list"><view class="menu-row" data-page="settings" bindtap="onOpen" hover-class="control--pressed"><image class="icon" src="/assets/icons/settings.svg" mode="aspectFit" /><view class="grow">设置与数据</view><image class="icon icon--small" src="/assets/icons/chevron.svg" mode="aspectFit" /></view></view><view wx:if="{{loading}}" class="state">正在加载个人资料…</view></view>
