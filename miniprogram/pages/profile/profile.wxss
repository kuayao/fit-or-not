.profile-head { padding: 23rpx 0 35rpx; display: flex; align-items: center; gap: 27rpx; }
.avatar { width: 108rpx; height: 108rpx; border-radius: 50%; background: var(--soft); display: flex; align-items: center; justify-content: center; overflow: hidden; }
.avatar-photo { width: 100%; height: 100%; }
.profile-title { font-size: 44rpx; font-weight: 400; letter-spacing: 1rpx; }
.profile-metrics { display: grid; grid-template-columns: repeat(3,1fr); text-align: center; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 36rpx 0; margin: 15rpx 0 54rpx; }
.profile-number { font-size: 44rpx; }
.profile-label { font-size: 21rpx; color: var(--muted); margin-top: 11rpx; }
