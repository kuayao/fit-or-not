<view class="outfit-editor {{busy ? 'outfit-editor--busy' : ''}}">
  <view class="editor-content">
    <view class="editor-heading">
      <view class="editor-name"><input class="editor-name__input" maxlength="60" value="{{name}}" bindinput="onInput" placeholder="为搭配起个名字" disabled="{{busy || loading || loadError}}" aria-label="搭配名称" /><image class="editor-name__icon" src="/assets/icons/edit.svg" mode="aspectFit" /></view>
      <button class="editor-clear" data-sheet="clear" bindtap="onOpenSheet" disabled="{{!selectedCount || loading || loadError}}" hover-class="control--pressed">清空</button>
    </view>
    <view id="canvas-stage" class="canvas-stage" bindtap="onDeselect">
      <view id="outfit-canvas" class="outfit-canvas" hidden="{{loading || loadError}}" style="{{canvasStyle}}background-color:{{backgroundColor}};">
        <image wx:for="{{items}}" wx:key="clothingId" class="canvas-item" src="{{item.imageUrl}}" data-url="{{item.imageUrl}}" binderror="onImageError" mode="aspectFit" style="{{item.style}}" data-id="{{item.clothingId}}" data-action="drag" catchtap="onSelect" bindtouchstart="onTouchStart" catchtouchmove="onTouchMove" bindtouchend="onTouchEnd" bindtouchcancel="onTouchEnd" aria-label="调整{{item.name}}" />
        <view wx:if="{{selectedId}}" class="canvas-selection" style="{{selectionStyle}}" data-id="{{selectedId}}" data-action="drag" catchtap="onSelect" bindtouchstart="onTouchStart" catchtouchmove="onTouchMove" bindtouchend="onTouchEnd" bindtouchcancel="onTouchEnd">
          <button class="canvas-handle canvas-handle--rotate" data-action="rotate" catchtap="onTool" catchtouchstart="onControlTouch" catchtouchmove="onControlTouch" aria-label="旋转衣物"><image class="canvas-handle__icon" src="/assets/icons/rotate.svg" mode="aspectFit" /></button>
          <button class="canvas-handle canvas-handle--remove" data-action="remove" catchtap="onTool" catchtouchstart="onControlTouch" catchtouchmove="onControlTouch" aria-label="移除衣物"><image class="canvas-handle__icon" src="/assets/icons/close.svg" mode="aspectFit" /></button>
          <button class="canvas-handle canvas-handle--resize" data-id="{{selectedId}}" data-action="resize" catchtap="onSelect" catchtouchstart="onTouchStart" catchtouchmove="onTouchMove" catchtouchend="onTouchEnd" catchtouchcancel="onTouchEnd" aria-label="拖动缩放衣物"><image class="canvas-handle__icon" src="/assets/icons/resize.svg" mode="aspectFit" /></button>
        </view>
        <view wx:if="{{!selectedCount}}" class="canvas-empty"><image class="canvas-empty__icon" src="/assets/icons/shirt.svg" mode="aspectFit" /><text>从衣橱挑选第一件衣物</text></view>
      </view>
      <view wx:if="{{loading}}" class="canvas-state">正在加载搭配…</view>
      <view wx:if="{{loadError}}" class="canvas-state"><text>{{loadError}}</text><button class="editor-link" catchtap="onRetry">重试</button></view>
      <view wx:if="{{error}}" class="canvas-notice" aria-role="alert">{{error}}</view>
    </view>
    <view class="canvas-footer">
      <text class="canvas-caption">{{selectedName || '轻点单品调整'}}</text>
      <view class="canvas-actions">
        <button class="canvas-action" bindtap="onUndo" disabled="{{!canUndo || loading || loadError}}" hover-class="control--pressed"><image class="canvas-action__icon" src="/assets/icons/undo.svg" mode="aspectFit" /><text>撤销</text></button>
        <button class="canvas-action" bindtap="onAutoLayout" disabled="{{!selectedCount || loading || loadError}}" hover-class="control--pressed"><image class="canvas-action__icon" src="/assets/icons/grid.svg" mode="aspectFit" /><text>排版</text></button>
        <button class="canvas-action" data-sheet="layers" bindtap="onOpenSheet" disabled="{{!selectedCount || loading || loadError}}" hover-class="control--pressed"><image class="canvas-action__icon" src="/assets/icons/layers.svg" mode="aspectFit" /><text>图层</text></button>
      </view>
    </view>
    <view class="editor-library">
      <view class="library-heading"><view class="library-tabs"><button class="library-tab {{activeTab === 'closet' ? 'library-tab--selected' : ''}}" data-tab="closet" bindtap="onTab" aria-pressed="{{activeTab === 'closet'}}">衣橱</button><button class="library-tab {{activeTab === 'background' ? 'library-tab--selected' : ''}}" data-tab="background" bindtap="onTab" aria-pressed="{{activeTab === 'background'}}">背景</button></view><text class="selection-count">已选 {{selectedCount}} 件</text></view>
      <view wx:if="{{activeTab === 'closet'}}">
        <scroll-view scroll-x show-scrollbar="{{false}}" class="clothing-filters"><view class="clothing-filters__row"><button class="clothing-filter {{!clothingCategoryId ? 'clothing-filter--selected' : ''}}" data-id="" bindtap="onClothingCategory" aria-pressed="{{!clothingCategoryId}}">全部</button><button wx:for="{{clothingCategories}}" wx:key="id" class="clothing-filter {{clothingCategoryId === item.id ? 'clothing-filter--selected' : ''}}" data-id="{{item.id}}" bindtap="onClothingCategory" aria-pressed="{{clothingCategoryId === item.id}}">{{item.name}}</button><text wx:if="{{clothingCategoriesLoading}}" class="filter-status">正在加载分类…</text><button wx:if="{{clothingCategoriesError}}" class="editor-link" bindtap="onRetryClothingCategories">分类加载失败 · 重试</button></view></scroll-view>
        <scroll-view scroll-x show-scrollbar="{{false}}" lower-threshold="80" bindscrolltolower="onMoreClothes" class="closet-scroll"><view class="closet-strip">
          <button wx:for="{{clothes}}" wx:key="id" class="closet-item {{item.selected ? 'closet-item--selected' : ''}}" data-id="{{item.id}}" bindtap="onAddClothing" disabled="{{loading || loadError}}" aria-label="{{item.selected ? '选择' : '添加'}}{{item.name || '未命名衣物'}}" aria-pressed="{{item.selected}}" hover-class="control--pressed"><image class="closet-item__image" src="{{item.imageUrl}}" data-url="{{item.imageUrl}}" binderror="onImageError" mode="aspectFit" /><view wx:if="{{item.selected}}" class="closet-item__check"><image src="/assets/icons/check.svg" mode="aspectFit" /></view></button>
          <block wx:if="{{loadingClothes && !clothes.length}}"><view wx:for="{{[0, 1, 2, 3, 4]}}" wx:key="*this" class="closet-skeleton" aria-label="正在加载衣橱" /></block>
          <view wx:elif="{{clothesError}}" class="closet-feedback {{clothes.length ? 'closet-feedback--append' : ''}}"><text>{{clothes.length ? '更多衣物加载失败' : '衣橱加载失败'}}</text><button class="editor-link" bindtap="onRetryClothes">重试</button></view>
          <view wx:elif="{{clothesLoaded && !clothes.length}}" class="closet-feedback"><text>{{clothingCategoryId ? '这个分类还没有衣物' : '衣橱里还没有衣物'}}</text><button wx:if="{{!clothingCategoryId}}" class="editor-link" bindtap="onAddNewClothing">添加衣物</button></view>
          <button wx:elif="{{clothes.length < clothesTotal}}" class="closet-more" bindtap="onMoreClothes" disabled="{{loadingClothes}}">{{loadingClothes ? '加载中…' : '更多'}}</button>
        </view></scroll-view>
      </view>
      <view wx:if="{{activeTab === 'background'}}" class="background-options"><button wx:for="{{backgrounds}}" wx:key="color" class="background-option {{backgroundColor === item.color ? 'background-option--selected' : ''}}" style="background-color:{{item.color}}" data-color="{{item.color}}" bindtap="onBackground" disabled="{{loading || loadError}}" aria-label="{{item.name}}背景" aria-pressed="{{backgroundColor === item.color}}"><image wx:if="{{backgroundColor === item.color}}" class="background-option__check" src="/assets/icons/check.svg" mode="aspectFit" /></button></view>
    </view>
    <view class="editor-metadata"><button class="metadata-option" disabled="{{loading || loadError}}" data-sheet="occasion" bindtap="onOpenSheet"><text class="metadata-option__label">场景</text><text class="metadata-option__value">{{occasion || '未指定'}}</text><image class="metadata-option__arrow" src="/assets/icons/chevron.svg" mode="aspectFit" /></button><button class="metadata-option" disabled="{{loading || loadError}}" data-sheet="category" bindtap="onOpenSheet"><text class="metadata-option__label">分类</text><text class="metadata-option__value">{{categoryName}}</text><image class="metadata-option__arrow" src="/assets/icons/chevron.svg" mode="aspectFit" /></button><button class="metadata-option" disabled="{{loading || loadError}}" data-sheet="settings" bindtap="onOpenSheet">更多<image class="metadata-option__arrow" src="/assets/icons/chevron.svg" mode="aspectFit" /></button></view>
  </view>
  <view class="editor-save"><t-button t-class="ui-button" class="button-block" block theme="primary" loading="{{busy}}" disabled="{{busy || loading || loadError || !selectedCount}}" bind:tap="onSave" custom-style="display:flex;width:100%">保存这套搭配</t-button></view>
</view>

<app-sheet visible="{{sheet === 'category'}}" title="搭配分类" scrollable busy="{{busy || categoryBusy}}" bind:close="onCloseSheet"><outfit-category-bar wx:if="{{sheet === 'category'}}" list items="{{categories}}" value="{{categoryId}}" loading="{{categoriesLoading}}" error="{{categoriesError}}" busy="{{busy || categoryBusy}}" create-error="{{categoryCreateError}}" bind:select="onCategory" bind:create="onCreateCategory" bind:retry="onRetryCategories" /></app-sheet>
<app-sheet visible="{{sheet === 'occasion'}}" title="使用场景" scrollable busy="{{busy}}" bind:close="onCloseSheet">
  <view wx:if="{{occasionsLoading}}" class="state">正在加载场景…</view><view wx:elif="{{occasionsError}}" class="sheet-load-error"><text>{{occasionsError}}</text><button class="editor-link" bindtap="onRetryOccasions">重试</button></view>
  <view wx:else class="sheet-options"><button class="sheet-option {{!occasion ? 'sheet-option--selected' : ''}}" data-value="" bindtap="onOccasion"><text class="sheet-option__name">未指定</text><image wx:if="{{!occasion}}" class="icon icon--small" src="/assets/icons/check.svg" mode="aspectFit" /></button><button wx:for="{{occasions}}" wx:key="id" class="sheet-option {{occasion === item.name ? 'sheet-option--selected' : ''}}" data-value="{{item.name}}" bindtap="onOccasion"><text class="sheet-option__name">{{item.name}}</text><image wx:if="{{occasion === item.name}}" class="icon icon--small" src="/assets/icons/check.svg" mode="aspectFit" /></button><view wx:if="{{!occasions.length}}" class="form-hint">还没有场景，可以直接填写</view></view>
  <view class="field"><view class="field-label">自定义场景</view><input class="input" maxlength="60" value="{{occasionDraft}}" bindinput="onOccasionInput" placeholder="例如：周末出游" /></view><view slot="footer"><t-button t-class="ui-button" class="button-block" block="{{true}}" custom-style="display:flex;width:100%" theme="primary" bind:tap="onConfirmOccasion">确认</t-button></view>
</app-sheet>
<app-sheet visible="{{sheet === 'settings'}}" title="更多设置" scrollable busy="{{busy}}" bind:close="onCloseSheet"><view class="field"><view class="field-label">适合季节</view><view class="sheet-tags sheet-tags--seasons"><view wx:for="{{settingsDraft.seasonOptions}}" wx:key="value" class="sheet-tag {{item.selected ? 'sheet-tag--selected' : ''}}" data-value="{{item.value}}" bindtap="onSeason" aria-role="button" aria-pressed="{{item.selected}}" hover-class="control--pressed">{{item.label}}</view></view></view><view class="field"><view class="field-label">备注</view><textarea class="textarea" maxlength="1000" value="{{settingsDraft.notes}}" bindinput="onNotesInput" placeholder="写点搭配灵感" /></view><view slot="footer"><t-button t-class="ui-button" class="button-block" block="{{true}}" custom-style="display:flex;width:100%" theme="primary" bind:tap="onConfirmSettings">完成</t-button></view></app-sheet>
<app-sheet visible="{{sheet === 'layers'}}" title="图层" scrollable busy="{{busy}}" bind:close="onCloseSheet"><view class="layer-list"><view wx:for="{{layers}}" wx:key="clothingId" class="layer-row {{selectedId === item.clothingId ? 'layer-row--selected' : ''}}"><button class="layer-select" data-id="{{item.clothingId}}" bindtap="onLayer" aria-label="选择{{item.name}}"><image class="layer-image" src="{{item.imageUrl}}" data-url="{{item.imageUrl}}" binderror="onImageError" mode="aspectFit" /><text class="layer-name">{{item.name}}</text></button><button class="layer-action" data-id="{{item.clothingId}}" data-action="front" bindtap="onLayerOrder" disabled="{{index === 0}}">置顶</button><button class="layer-action" data-id="{{item.clothingId}}" data-action="back" bindtap="onLayerOrder" disabled="{{index === layers.length - 1}}">置底</button></view></view></app-sheet>
<app-sheet visible="{{sheet === 'clear'}}" title="清空画布？" size="small" busy="{{busy}}" bind:close="onCloseSheet"><view class="form-hint">移除画布上的所有衣物。</view><view slot="footer"><t-button t-class="ui-button" class="button-block" block="{{true}}" custom-style="display:flex;width:100%" theme="primary" bind:tap="onConfirmClear">清空画布</t-button></view></app-sheet>
