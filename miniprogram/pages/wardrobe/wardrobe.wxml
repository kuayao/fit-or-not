<view class="wardrobe">
  <view class="wardrobe-header">
    <view class="wardrobe-heading"><image class="icon" src="/assets/icons/project-mark-clasp.svg" mode="aspectFit" /><view class="wardrobe-title">{{section === 'sets' ? '我的衣橱' : draft ? '待核对衣物' : archived ? '归档衣物' : '我的衣橱'}}</view></view>
    <view wx:if="{{section === 'items'}}" class="wardrobe-tools">
      <button class="icon-button {{managing ? 'wardrobe-manage--active' : ''}}" bindtap="onManage" disabled="{{busy}}" aria-label="{{managing ? '结束整理' : '批量整理'}}"><text wx:if="{{managing}}">完成</text><image wx:else class="icon" src="/assets/icons/check.svg" mode="aspectFit" /></button>
      <button class="icon-button" bindtap="onToggleSearch" aria-label="搜索衣物"><image class="icon" src="/assets/icons/search.svg" mode="aspectFit" /></button>
      <button class="icon-button" bindtap="onFilters" aria-label="筛选衣物"><image class="icon" src="/assets/icons/filter.svg" mode="aspectFit" /><view wx:if="{{favorite || color || season || occasionIds || sortIndex}}" class="wardrobe-filter-dot" /></button>
      <button class="icon-button" bindtap="onWardrobeMenu" aria-label="更多衣橱操作"><image class="icon" src="/assets/icons/more.svg" mode="aspectFit" /></button>
    </view>
  </view>
  <view class="wardrobe-sections">
    <view class="wardrobe-section {{section === 'items' ? 'wardrobe-section--selected' : ''}}" data-section="items" bindtap="onSection" aria-role="tab" aria-selected="{{section === 'items'}}">单品</view>
    <view class="wardrobe-section {{section === 'sets' ? 'wardrobe-section--selected' : ''}}" data-section="sets" bindtap="onSection" aria-role="tab" aria-selected="{{section === 'sets'}}">套装</view>
    <view class="wardrobe-tasks" bindtap="onTasks" aria-role="button"><image class="wardrobe-tasks__icon" src="/assets/icons/clock.svg" mode="aspectFit" />处理与审核</view>
  </view>
  <view class="wardrobe-sets" hidden="{{section !== 'sets'}}"><clothing-sets refresh="{{setRefresh}}" /></view>
  <view wx:if="{{searchOpen && section === 'items'}}" class="wardrobe-search"><view class="search"><image class="icon icon--small" src="/assets/icons/search.svg" mode="aspectFit" /><input class="input grow" value="{{q}}" bindinput="onSearchInput" bindconfirm="onSearch" confirm-type="search" placeholder="寻找一件衣物…" /></view></view>
  <view wx:if="{{archived && section === 'items'}}" class="notice wardrobe-notice">归档保留历史记录，衣物随时可以恢复。<view class="text-button" bindtap="onArchived">返回日常衣橱</view></view>
  <view class="wardrobe-body" hidden="{{section !== 'items'}}">
    <scroll-view wx:if="{{!sidebarCollapsed}}" scroll-y enhanced class="wardrobe-sidebar" show-scrollbar="{{false}}">
      <view class="wardrobe-category {{!draft && !rootCategoryId ? 'wardrobe-category--selected' : ''}}" data-id="" bindtap="onRootCategory" aria-role="button" aria-label="全部一级分类" aria-pressed="{{!draft && !rootCategoryId}}"><image class="wardrobe-category__icon" src="/assets/icons/grid.svg" mode="aspectFit" /><text>全部</text></view>
      <view class="wardrobe-category {{draft ? 'wardrobe-category--selected' : ''}}" bindtap="onReviewCategory" aria-role="button" aria-label="待核对衣物" aria-pressed="{{draft}}"><image class="wardrobe-category__icon" src="/assets/icons/clock.svg" mode="aspectFit" /><text>待核对</text></view>
      <view wx:for="{{rootCategories}}" wx:key="id" class="wardrobe-category {{!draft && rootCategoryId === item.id ? 'wardrobe-category--selected' : ''}}" data-id="{{item.id}}" bindtap="onRootCategory" aria-role="button" aria-pressed="{{!draft && rootCategoryId === item.id}}"><image class="wardrobe-category__icon" src="/assets/icons/{{item.icon}}.svg" mode="aspectFit" /><text>{{item.name}}</text></view>
      <view wx:if="{{taxonomyLoading && !rootCategories.length}}" class="wardrobe-sidebar__state">加载中…</view>
    </scroll-view>
    <view class="wardrobe-divider"><button class="wardrobe-collapse" bindtap="onToggleSidebar" aria-label="{{sidebarCollapsed ? '展开一级分类' : '收起一级分类'}}"><image class="wardrobe-collapse__icon {{sidebarCollapsed ? 'wardrobe-collapse__icon--open' : ''}}" src="/assets/icons/back.svg" mode="aspectFit" /></button></view>
    <scroll-view class="wardrobe-content" scroll-y enhanced show-scrollbar="{{false}}" lower-threshold="200" bindscrolltolower="onLoadMore">
      <view class="wardrobe-content__inner">
        <view class="wardrobe-summary"><text class="count-note">{{loading && !loaded ? '正在加载' : '共 ' + total + ' 件'}}</text><view class="wardrobe-taxonomy" bindtap="onTaxonomy" aria-role="button">分类管理</view></view>
        <view wx:if="{{taxonomyError}}" class="error" bindtap="onRetryTaxonomy">{{taxonomyError}} · 点击重试</view>
        <scroll-view wx:if="{{rootCategoryId}}" class="wardrobe-subcategories" scroll-x show-scrollbar="{{false}}" scroll-into-view="subcategory-{{categoryId}}" scroll-with-animation aria-label="二级分类，左右滑动查看更多">
            <view id="subcategory-{{rootCategoryId}}" class="chip {{categoryId === rootCategoryId ? 'chip--selected' : ''}}" data-id="{{rootCategoryId}}" bindtap="onSubCategory" aria-role="button" aria-pressed="{{categoryId === rootCategoryId}}">全部</view>
            <view wx:for="{{subCategories}}" wx:key="id" id="subcategory-{{item.id}}" class="chip {{categoryId === item.id ? 'chip--selected' : ''}}" data-id="{{item.id}}" bindtap="onSubCategory" aria-role="button" aria-pressed="{{categoryId === item.id}}">{{item.name}}</view>
        </scroll-view>
  <view wx:if="{{error}}" class="error" bindtap="onRetryClothes">{{error}} · 点击重试</view>

  <view wx:if="{{loading && !clothes.length && !imports.length}}" class="skeleton-grid"><view wx:for="{{[1,2,3,4]}}" wx:key="*this"><view class="skeleton" /><view class="skeleton-line" /></view></view>
  <view wx:if="{{draft && imports.length}}" class="unfinished-imports">
    <view class="unfinished-imports__heading">未完成的照片 · {{importTotal}} 张</view>
    <view wx:for="{{imports}}" wx:key="id" class="unfinished-import" data-id="{{item.id}}" bindtap="onImport" aria-role="button" aria-label="{{item.pending ? '正在定位衣物' : '识别未完成，点击处理'}}">
      <image class="unfinished-import__image" src="{{item.imageUrl}}" data-url="{{item.imageUrl}}" binderror="onImageError" mode="aspectFit" />
      <view class="unfinished-import__content"><view class="unfinished-import__status">{{item.pending ? '正在定位衣物' : '识别未完成'}}</view><view class="unfinished-import__name">{{item.name || '套装照片'}}</view><view class="unfinished-import__hint">{{item.pending ? '完成后自动更新' : '未生成单品 · 点击处理'}}</view></view>
      <image class="unfinished-import__arrow" src="/assets/icons/chevron.svg" mode="aspectFit" />
    </view>
  </view>
  <view class="grid">
    <view wx:for="{{clothes}}" wx:key="id" class="clothing-card {{item.selected ? 'clothing-card--selected' : ''}}">
      <view class="clothing-visual" data-id="{{item.id}}" bindtap="onClothing" aria-role="button" aria-disabled="{{item.processing}}" aria-label="{{item.processing ? item.processText : item.name}}">
        <image class="garment" src="{{item.imageUrl}}" data-url="{{item.imageUrl}}" binderror="onImageError" mode="aspectFit" />
        <view wx:if="{{managing && !item.processing}}" class="clothing-selection {{item.selected ? 'clothing-selection--selected' : ''}}"><image wx:if="{{item.selected}}" class="clothing-selection__icon" src="/assets/icons/check.svg" mode="aspectFit" /></view>
        <view wx:if="{{item.processing}}" class="clothing-processing">
          <image class="clothing-processing__icon" src="/assets/icons/sparkles.svg" mode="aspectFit" />
          <view class="clothing-processing__title">{{item.processText}}</view>
          <view class="clothing-processing__hint">完成后自动更新</view>
        </view>
      </view>
      <button wx:if="{{!managing && item.status !== 'draft' && !item.processing}}" class="icon-button heart-button {{item.favorite ? 'heart-button--selected' : ''}}" disabled="{{busy || loading}}" data-id="{{item.id}}" bindtap="onCardFavorite" aria-label="{{item.favorite ? '取消收藏' : '收藏'}}"><image class="icon" src="/assets/icons/{{item.favorite ? 'heart-filled' : 'heart'}}.svg" mode="aspectFit" /></button>
      <view wx:if="{{!item.processing && item.reviewText}}" class="soft-tag clothing-review" data-id="{{item.id}}" bindtap="onClothing">{{item.reviewText}}</view>
      <view class="card-name">{{item.selected ? '已选 · ' : ''}}{{item.name || (item.processing ? '待识别衣物' : '未命名衣物')}}</view>
      <view class="card-meta"><text class="label-dot" />{{item.categoryName || (item.processing ? '分类待识别' : '分类待确认')}} · {{item.colorText || (item.processing ? '色系待识别' : '色系待确认')}}</view>
    </view>
  </view>
  <view wx:if="{{loading && clothes.length}}" class="state">正在加载衣物…</view>
  <view wx:if="{{loaded && !loading && !clothes.length && (!draft || !imports.length) && !error}}" class="empty-state">
    <image class="empty-icon" src="/assets/icons/project-mark-clasp.svg" mode="aspectFit" />
    <view class="empty-title">{{q || categoryId || favorite || color || season || occasionIds || tagId ? '这里还没有衣物' : draft ? '暂无待核对衣物' : '衣橱空空如也'}}</view>
    <view wx:if="{{!draft}}" class="empty-copy">{{q || categoryId || favorite || color || season || occasionIds || tagId ? '换个分类或筛选，也可以添一件新衣物。' : '拍照或从相册添加你的第一件衣物吧'}}</view>
    <t-button t-class="ui-button" theme="primary" bind:tap="onAdd">添加衣物</t-button>
    <view wx:if="{{q || categoryId || favorite || color || season || occasionIds || tagId}}" class="text-button text-button--center" bindtap="onClearFilters">清除筛选</view>
  </view>
      </view>
    </scroll-view>
  </view>
  <view wx:if="{{managing}}" class="wardrobe-batch">
    <view class="wardrobe-batch__count">已选 {{selectedIds.length}} 件</view>
    <view class="wardrobe-batch__actions">
      <t-button t-class="ui-button" size="small" block custom-style="display:flex;width:100%" disabled="{{busy || loading || !selectedIds.length}}" data-action="{{archived ? 'restore' : 'archive'}}" bind:tap="onBatch">{{archived ? '恢复' : '归档'}}</t-button>
      <t-button t-class="ui-button" size="small" block custom-style="display:flex;width:100%" disabled="{{busy || loading || !selectedIds.length}}" data-action="edit" bind:tap="onBatch">改标签</t-button>
      <t-button t-class="ui-button ui-button--danger" theme="danger" variant="outline" size="small" block custom-style="display:flex;width:100%" disabled="{{busy || loading || !selectedIds.length}}" data-action="delete" bind:tap="onBatch">删除</t-button>
    </view>
  </view>
</view>
<app-sheet visible="{{filtersOpen}}" title="筛选衣物" scrollable bind:close="onCloseFilters">
  <view class="sheet-note">选择你想看的衣物。</view>
  <view class="sheet-option {{filterFavorite ? 'sheet-option--selected' : ''}}" bindtap="onFilterFavorite" hover-class="control--pressed" aria-role="button" aria-pressed="{{filterFavorite}}"><image class="icon icon--small" src="/assets/icons/heart.svg" mode="aspectFit" /><text class="sheet-option__name">只看收藏</text><view class="sheet-option__check"><image wx:if="{{filterFavorite}}" class="sheet-option__check-image" src="/assets/icons/check.svg" mode="aspectFit" /></view></view>
  <view wx:if="{{taxonomyLoading}}" class="sheet-note">正在加载筛选选项…</view>
  <view wx:elif="{{taxonomyError}}" class="error" bindtap="onRetryTaxonomy">{{taxonomyError}} · 点击重试</view>
  <view class="filter-sheet__group"><view class="field-label">场景 · 可多选</view><view class="sheet-tags sheet-tags--pair"><view wx:for="{{filterOccasions}}" wx:key="id" class="sheet-tag {{item.selected ? 'sheet-tag--selected' : ''}}" data-id="{{item.id}}" bindtap="onFilterOccasion" hover-class="control--pressed" aria-role="button" aria-pressed="{{item.selected}}">{{item.name}}</view></view><view wx:if="{{!taxonomyLoading && !taxonomyError && !filterOccasions.length}}" class="form-hint">还没有场景标签，可在“我的 → 分类与标签”中添加。</view></view>
  <view class="filter-sheet__group"><view class="field-label">色系 · 可多选</view><view class="color-options"><view wx:for="{{filterColors}}" wx:key="value" class="color-option {{item.selected ? 'color-option--selected' : ''}}" style="background:{{item.swatch}}" data-value="{{item.value}}" bindtap="onColor" aria-role="button" aria-label="{{item.label}}" aria-pressed="{{item.selected}}" /></view></view>
  <view class="filter-sheet__group"><view class="field-label">季节 · 可多选</view><view class="sheet-tags sheet-tags--seasons"><view wx:for="{{filterSeasons}}" wx:key="value" class="sheet-tag {{item.selected ? 'sheet-tag--selected' : ''}}" data-value="{{item.value}}" bindtap="onSeason" hover-class="control--pressed" aria-role="button" aria-pressed="{{item.selected}}">{{item.label}}</view></view></view>
  <view class="filter-sheet__group"><view class="field-label">排序</view><view class="sheet-tags sheet-tags--pair"><view wx:for="{{sortLabels}}" wx:key="*this" class="sheet-tag {{filterSortIndex === index ? 'sheet-tag--selected' : ''}}" data-index="{{index}}" bindtap="onSort" hover-class="control--pressed" aria-role="button" aria-pressed="{{filterSortIndex === index}}">{{item}}</view></view></view>
  <view class="form-hint">不选表示不限；同一组匹配任一选项，各组条件同时满足。</view>
  <view slot="footer"><t-button t-class="ui-button" class="button-block" block custom-style="display:flex;width:100%" theme="primary" bind:tap="onApplyFilters">查看结果</t-button><view class="sheet-link" bindtap="onClearFilters" aria-role="button" hover-class="control--pressed">清除全部筛选</view></view>
</app-sheet>

<app-sheet visible="{{batchOpen}}" title="批量改标签" size="large" busy="{{busy}}" bind:close="onCloseBatch">
  <view class="batch-cascade">
    <scroll-view class="batch-cascade__tabs" scroll-y show-scrollbar="{{false}}" aria-label="标签类型">
      <button wx:for="{{batchFields}}" wx:key="id" class="batch-cascade__tab {{batchField === item.id ? 'batch-cascade__tab--selected' : ''}}" disabled="{{busy || batchLoading}}" data-id="{{item.id}}" bindtap="onBatchField" aria-pressed="{{batchField === item.id}}">{{item.name}}</button>
    </scroll-view>
    <view class="batch-cascade__main">
      <view wx:if="{{batchLoading}}" class="batch-cascade__state">正在加载…</view>
      <view wx:elif="{{batchTaxonomyError}}" class="batch-cascade__state error" bindtap="onRetryBatchTaxonomy">{{batchTaxonomyError}} · 点击重试</view>
      <view wx:elif="{{batchField === 'categoryId'}}" class="batch-cascade__categories">
        <view class="batch-cascade__column batch-cascade__column--roots">
          <view class="batch-cascade__heading">一级分类</view>
          <scroll-view class="batch-cascade__list" scroll-y show-scrollbar="{{false}}" aria-label="一级分类">
            <button wx:for="{{batchOptions}}" wx:key="id" class="batch-cascade__option {{batchRootId === item.id ? 'batch-cascade__option--selected' : ''}}" disabled="{{busy}}" data-id="{{item.id}}" bindtap="onBatchOption" aria-pressed="{{batchRootId === item.id}}"><text class="batch-cascade__name">{{item.name}}</text><image class="batch-cascade__icon" src="/assets/icons/chevron.svg" mode="aspectFit" /></button>
            <view wx:if="{{!batchOptions.length}}" class="batch-cascade__state">还没有分类</view>
          </scroll-view>
        </view>
        <view class="batch-cascade__column">
          <view class="batch-cascade__heading">二级分类</view>
          <scroll-view class="batch-cascade__list" scroll-y show-scrollbar="{{false}}" aria-label="二级分类">
            <view wx:if="{{!batchRootId}}" class="batch-cascade__state">先选一级分类</view>
            <block wx:else>
              <button class="batch-cascade__option {{batchValues[0] === batchRootId ? 'batch-cascade__option--selected' : ''}}" disabled="{{busy}}" data-id="{{batchRootId}}" bindtap="onBatchChildOption" aria-pressed="{{batchValues[0] === batchRootId}}"><text class="batch-cascade__name">仅一级</text><image wx:if="{{batchValues[0] === batchRootId}}" class="batch-cascade__icon" src="/assets/icons/check.svg" mode="aspectFit" /></button>
              <button wx:for="{{batchChildOptions}}" wx:key="id" class="batch-cascade__option {{item.selected ? 'batch-cascade__option--selected' : ''}}" disabled="{{busy}}" data-id="{{item.id}}" bindtap="onBatchChildOption" aria-pressed="{{item.selected}}"><text class="batch-cascade__name">{{item.name}}</text><image wx:if="{{item.selected}}" class="batch-cascade__icon" src="/assets/icons/check.svg" mode="aspectFit" /></button>
            </block>
          </scroll-view>
        </view>
      </view>
      <view wx:else class="batch-cascade__choices">
        <view wx:if="{{batchField === 'occasion' || batchField === 'style'}}" class="batch-cascade__modes"><button wx:for="{{batchModes}}" wx:key="id" class="batch-cascade__mode {{batchMode === item.id ? 'batch-cascade__mode--selected' : ''}}" disabled="{{busy}}" data-id="{{item.id}}" bindtap="onBatchMode" aria-pressed="{{batchMode === item.id}}">{{item.name}}</button></view>
        <scroll-view class="batch-cascade__list" scroll-y show-scrollbar="{{false}}" aria-label="标签选项">
          <view class="batch-cascade__grid">
            <button wx:for="{{batchOptions}}" wx:key="id" class="batch-cascade__option batch-cascade__option--tile {{item.selected ? 'batch-cascade__option--selected' : ''}}" disabled="{{busy}}" data-id="{{item.id}}" bindtap="onBatchOption" aria-pressed="{{item.selected}}"><text class="batch-cascade__name">{{item.name}}</text><image wx:if="{{item.selected}}" class="batch-cascade__icon" src="/assets/icons/check.svg" mode="aspectFit" /></button>
          </view>
          <view wx:if="{{!batchOptions.length}}" class="batch-cascade__state">还没有可选项</view>
        </scroll-view>
      </view>
    </view>
  </view>
  <view slot="footer">
    <view wx:if="{{batchError}}" class="error">{{batchError}}</view>
    <view class="batch-cascade__summary">{{batchSummary}}</view>
    <view wx:if="{{batchField === 'sizeId'}}" class="batch-cascade__hint">服装尺码与鞋码需分开修改</view>
    <t-button t-class="ui-button" class="button-block" theme="primary" block custom-style="display:flex;width:100%" loading="{{busy}}" disabled="{{busy || loading || !selectedIds.length || batchLoading || !!batchTaxonomyError || (!batchMultiple && !batchValues.length) || ((batchField === 'occasion' || batchField === 'style') && batchMode !== 'replace' && !batchValues.length)}}" bind:tap="onConfirmBatch">应用到 {{selectedIds.length}} 件衣物</t-button>
  </view>
</app-sheet>

<app-select-sheet visible="{{menuOpen}}" title="衣橱管理" items="{{menuItems}}" bind:select="onMenuSelect" bind:close="onCloseMenu" />
