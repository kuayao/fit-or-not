<view class="page clothing-detail"><view wx:if="{{error}}" class="error" bindtap="onRetry">{{error}} · 点击重试</view><app-loading wx:if="{{loading}}" variant="{{clothing ? 'inline' : 'detail'}}" text="正在加载衣物" /><block wx:if="{{clothing}}">
  <view class="detail-hero" bindtap="onPreview"><image class="garment" src="{{imageUrl}}" data-url="{{imageUrl}}" binderror="onImageError" mode="aspectFit" /><view class="mini-badge"><image class="icon" src="/assets/icons/check.svg" mode="aspectFit" />{{clothing.status === 'archived' ? '已归档' : clothing.status === 'draft' ? '待确认' : '衣橱单品'}}</view></view>
  <view wx:if="{{processing}}" class="notice">{{clothing.processingPhase}} · AI 处理完成后可修改资料。</view><view class="detail-title"><view class="grow"><view class="detail-name">{{clothing.name}}</view><view class="subtitle">{{clothing.categoryName || '未分类草稿'}} · {{colorText || '颜色未填写'}}</view></view><button class="icon-button" disabled="{{busy || loading || processing}}" bindtap="onFavorite" aria-label="{{clothing.favorite ? '取消收藏' : '收藏'}}"><image class="icon" src="/assets/icons/{{clothing.favorite ? 'heart-filled' : 'heart'}}.svg" mode="aspectFit" /></button></view>
  <view wx:if="{{seasonText || clothing.brand}}" class="tag-row"><view wx:if="{{seasonText}}" class="soft-tag">{{seasonText}}</view><view wx:if="{{clothing.brand}}" class="soft-tag">{{clothing.brand}}</view></view>
  <view class="stats-inline"><view class="stats-inline__item"><view class="stats-inline__value">{{clothing.wearCount}}<text class="count-note"> 次</text></view><view class="stats-inline__label">已记录穿着日</view></view><view class="stats-inline__item"><view class="stats-inline__value">{{clothing.priceCents === null ? '—' : '¥' + price}}</view><view class="stats-inline__label">购入价格</view></view><view class="stats-inline__item"><view class="stats-inline__value">{{cost}}</view><view class="stats-inline__label">每次穿着成本</view></view></view>
  <view class="info-list detail-summary"><view class="info-line"><text class="info-label">最近穿着</text><text class="info-value {{clothing.lastWornOn ? '' : 'info-value--empty'}}">{{clothing.lastWornOn || '尚未记录'}}</text></view><view class="info-line detail-notes"><text class="info-label">备注</text><text class="info-value {{clothing.notes ? '' : 'info-value--empty'}}">{{clothing.notes || '未填写'}}</text></view></view>
  <view class="entry-row" hover-class="control--pressed" bindtap="onInfo"><view class="grow">更多衣物资料<view class="form-hint">品牌、尺码、面料与细节照片</view></view><image class="icon icon--small" src="/assets/icons/chevron.svg" mode="aspectFit" /></view>
  <view wx:if="{{clothing.clothingSet}}" class="section"><view class="entry-row" bindtap="onSet"><image wx:if="{{setCoverUrl}}" class="thumb" src="{{setCoverUrl}}" data-url="{{setCoverUrl}}" binderror="onImageError" mode="aspectFit" /><view class="grow"><view class="form-hint">所属套装</view>{{clothing.clothingSet.name}}</view><image class="icon icon--small" src="/assets/icons/chevron.svg" /></view><view class="field-label">同套单品</view><scroll-view class="set-siblings" scroll-x><view wx:for="{{setMembers}}" wx:key="id" class="set-siblings__item" data-id="{{item.id}}" bindtap="onSetMember"><image class="set-siblings__image" src="{{item.imageUrl}}" data-url="{{item.imageUrl}}" binderror="onImageError" mode="aspectFit" /><view>{{item.name}}</view></view></scroll-view></view>
  <view class="detail-footer">
    <t-button t-class="ui-button" class="button-block" block="{{true}}" disabled="{{busy || loading || processing}}" bind:tap="onEdit" aria-label="编辑资料"><image class="icon icon--small" src="/assets/icons/edit.svg" mode="aspectFit" /> 编辑</t-button>
    <t-button t-class="ui-button" class="button-block" block="{{true}}" bind:tap="onMore"><image class="icon icon--small" src="/assets/icons/more.svg" mode="aspectFit" /> 更多</t-button>
  </view>
</block></view>

<app-sheet visible="{{showInfo}}" title="衣物资料" scrollable bind:close="onCloseInfo">
<view class="info-list"><view class="info-line"><text class="info-label">具体类型</text><text>{{clothing.itemType || '未填写'}}</text></view><view class="info-line"><text class="info-label">颜色描述</text><text>{{clothing.colorDescription || '未填写'}}</text></view><view class="info-line"><text class="info-label">图案</text><text>{{patternText || '未填写'}}</text></view><view class="info-line"><text class="info-label">可见特征</text><text>{{featuresText || '未填写'}}</text></view><view class="info-line"><text class="info-label">购买日期</text><text>{{clothing.purchasedOn || '未填写'}}</text></view><view class="info-line"><text class="info-label">品牌</text><text>{{clothing.brand || '未填写'}}</text></view><view class="info-line"><text class="info-label">尺码</text><text>{{clothing.sizeLabel || '未填写'}}</text></view><view class="info-line"><text class="info-label">面料</text><text>{{clothing.material || '未填写'}}</text></view></view><view wx:if="{{detailPhotos.length}}" class="chips"><image wx:for="{{detailPhotos}}" wx:key="id" class="thumb" src="{{item.imageUrl}}" data-url="{{item.imageUrl}}" binderror="onImageError" mode="aspectFit" bindtap="onPreview" /></view>
</app-sheet>
<app-sheet visible="{{showMore}}" title="管理这件衣物" size="small" busy="{{busy}}" bind:close="onCloseMore">
  <view wx:if="{{error}}" class="error">{{error}}</view><view class="form-hint sheet-note">归档保留衣物资料和历史穿着，可随时恢复。</view>
  <view class="sheet-actions"><t-button t-class="ui-button" disabled="{{busy || clothing.status !== 'active'}}" bind:tap="onWear" block="{{true}}" custom-style="display:flex;width:100%" class="button-block"><image class="icon icon--small" src="/assets/icons/calendar.svg" /> 记录穿着</t-button><t-button t-class="ui-button" disabled="{{busy || processing}}" bind:tap="onArchive" block="{{true}}" custom-style="display:flex;width:100%" class="button-block"><image class="icon icon--small" src="/assets/icons/archive.svg" /> {{clothing.status === 'archived' ? '恢复到衣橱' : '归档衣物'}}</t-button><t-button t-class="ui-button ui-button--danger" theme="danger" variant="outline" disabled="{{busy || processing}}" bind:tap="onDelete" block="{{true}}" custom-style="display:flex;width:100%" class="button-block"><image class="icon icon--small" src="/assets/icons/trash.svg" /> 永久删除</t-button></view>
</app-sheet>
