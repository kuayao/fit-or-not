<view class="page"><app-loading wx:if="{{loading}}" variant="{{outfit ? 'inline' : 'detail'}}" text="正在加载搭配" /><view wx:if="{{error}}" class="error" bindtap="onRetry">{{error}} · 点击刷新</view><block wx:if="{{outfit}}"><view class="outfit-canvas" style="background-color:{{outfit.backgroundColor}}"><image wx:for="{{layers}}" wx:key="clothingId" class="canvas-item" style="{{item.style}}" src="{{item.imageUrl}}" data-url="{{item.imageUrl}}" binderror="onImageError" mode="aspectFit" /></view><view class="detail-title"><view class="detail-name grow">{{outfit.name}}</view><button class="icon-button" bindtap="onFavorite" aria-label="收藏搭配"><image class="icon" src="/assets/icons/{{outfit.favorite ? 'heart-filled' : 'heart'}}.svg" /></button></view><view class="subtitle">{{outfit.occasion || '日常'}} · {{clothes.length}} 件单品</view><view wx:if="{{outfit.notes}}" class="section">{{outfit.notes}}</view><view class="section"><t-button t-class="ui-button" class="button-block" block="{{true}}" custom-style="display:flex;width:100%" theme="primary" disabled="{{busy}}" bind:tap="onWear"><image class="icon icon--small" src="/assets/icons/calendar.svg" mode="aspectFit" /> 记录今天穿过</t-button></view><view class="actions"><t-button t-class="ui-button" class="button-block" block="{{true}}" custom-style="display:flex;width:100%" disabled="{{busy}}" bind:tap="onEdit"><image class="icon icon--small" src="/assets/icons/edit.svg" mode="aspectFit" /> 编辑</t-button><t-button t-class="ui-button" class="button-block" block="{{true}}" custom-style="display:flex;width:100%" disabled="{{busy}}" bind:tap="onMore"><image class="icon icon--small" src="/assets/icons/more.svg" mode="aspectFit" /> 更多</t-button></view><view wx:if="{{!outfit.coverAssetId}}" class="notice section" bindtap="onRetry">封面正在生成，点击刷新</view><view class="field-label section">搭配分类</view><outfit-category-bar items="{{categories}}" value="{{categoryId}}" loading="{{categoriesLoading}}" error="{{categoriesError}}" busy="{{busy || categoryBusy || loading}}" create-error="{{categoryCreateError}}" bind:select="onCategory" bind:create="onCreateCategory" bind:retry="onRetryCategories" /><view class="section-title section">这套搭配里的衣物</view><view wx:for="{{clothes}}" wx:key="id" class="list-item row" data-id="{{item.id}}" bindtap="onClothing"><image class="thumb" src="{{item.imageUrl}}" data-url="{{item.imageUrl}}" binderror="onImageError" mode="aspectFit" /><view>{{item.name}}{{item.status === 'archived' ? ' · 已归档' : ''}}</view></view></block></view>

<app-sheet visible="{{showMore}}" title="管理这套搭配" size="small" busy="{{busy}}" bind:close="onCloseMore"><view wx:if="{{error}}" class="error">{{error}}</view><view class="sheet-actions"><t-button t-class="ui-button" disabled="{{busy}}" bind:tap="onTryOn" block="{{true}}" custom-style="display:flex;width:100%" class="button-block"><image class="icon icon--small" src="/assets/icons/sparkles.svg" /> 虚拟试穿</t-button><t-button t-class="ui-button" disabled="{{busy || !outfit.coverAssetId}}" bind:tap="onExport" block="{{true}}" custom-style="display:flex;width:100%" class="button-block"><image class="icon icon--small" src="/assets/icons/download.svg" /> 导出搭配展示图</t-button><view wx:if="{{!outfit.coverAssetId}}" class="form-hint">封面生成后即可导出</view><t-button t-class="ui-button ui-button--danger" theme="danger" variant="outline" disabled="{{busy}}" bind:tap="onDelete" block="{{true}}" custom-style="display:flex;width:100%" class="button-block"><image class="icon icon--small" src="/assets/icons/trash.svg" /> 删除搭配</t-button></view></app-sheet>
