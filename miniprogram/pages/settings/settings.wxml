<view class="page"><view wx:if="{{error}}" class="error" bindtap="onRetry">{{error}} · 点击重试</view>
  <view class="menu-list"><view class="menu-row" bindtap="onNickname" hover-class="control--pressed"><view class="grow">昵称</view><text class="count-note">{{nickname}}</text><image class="icon icon--small" src="/assets/icons/chevron.svg" mode="aspectFit" /></view><view class="field"><view class="field-label">默认城市</view><input class="input" maxlength="100" value="{{cityCode}}" bindinput="onCity" placeholder="例如：hangzhou" /></view><view class="menu-row row--between"><view class="grow">默认显示归档衣物</view><switch checked="{{showArchived}}" color="#426E91" bindchange="onArchived" /></view><view class="menu-row" hover-class="control--pressed" bindtap="onServices"><view class="grow">外部服务状态</view><image class="icon icon--small" src="/assets/icons/chevron.svg" /></view></view><t-button t-class="ui-button" class="button-block" block="{{true}}" custom-style="display:flex;width:100%" theme="primary" loading="{{busy}}" disabled="{{busy || loading}}" bind:tap="onSave">保存设置</t-button>
  <view class="menu-list"><view class="menu-row" bindtap="onExport" hover-class="control--pressed"><image class="icon" src="/assets/icons/download.svg" mode="aspectFit" /><view class="grow">导出我的数据<view class="subtitle">衣物、搭配、穿搭记录与本人图片</view></view><image class="icon icon--small" src="/assets/icons/chevron.svg" mode="aspectFit" /></view><view class="menu-row" bindtap="onDataInfo" hover-class="control--pressed" aria-role="button" aria-expanded="{{showDataInfo}}"><image class="icon" src="/assets/icons/lock.svg" mode="aspectFit" /><view class="grow">数据与图片<view class="subtitle">{{showDataInfo ? '点击收起说明' : '了解存储与删除规则'}}</view></view><image class="icon icon--small" src="/assets/icons/chevron.svg" mode="aspectFit" /></view><view wx:if="{{showDataInfo}}" class="notice">衣物、搭配、记录与照片独立归属于你的账号。导出只含本人数据，文件 24 小时后过期。注销会立即撤销会话，再由后台清理本人数据与图片。</view></view><view wx:if="{{exportStatus}}" class="notice">{{exportStatus}}</view><view wx:if="{{exportReady}}" class="section"><t-button t-class="ui-button" class="button-block" block="{{true}}" custom-style="display:flex;width:100%" disabled="{{busy}}" bind:tap="onDownload">下载并打开文件分享</t-button></view><view class="section"><t-button t-class="ui-button" class="button-block" block="{{true}}" custom-style="display:flex;width:100%" disabled="{{busy}}" bind:tap="onLogout">退出登录</t-button></view><view class="text-button text-button--center danger" bindtap="onDelete" hover-class="control--pressed">注销账号</view><view wx:if="{{loading}}" class="state">正在加载设置…</view></view>

<app-sheet visible="{{showServices}}" title="服务状态" scrollable bind:close="onCloseServices"><view wx:for="{{services}}" wx:key="name" class="list-item"><view class="row row--between"><text>{{item.name}}</text><view class="soft-tag">{{item.available ? '已配置' : '未配置'}}</view></view><view class="subtitle">{{item.reason}}</view></view></app-sheet>
