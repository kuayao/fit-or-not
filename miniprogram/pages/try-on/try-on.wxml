<view class="page"><view wx:if="{{error}}" class="error" bindtap="onRetry">{{error}} · 点击重试</view>
  <view class="photo-pair"><view class="photo-slot"><image class="photo-placeholder" src="/assets/icons/user.svg" mode="aspectFit" /><view class="photo-caption">你的上身照片</view></view><view class="photo-slot"><image class="photo-placeholder" src="/assets/icons/layers.svg" mode="aspectFit" /><view class="photo-caption">所选搭配</view></view></view><view class="section-title">选择自己的搭配</view><view class="chips"><view wx:for="{{outfits}}" wx:key="id" class="chip {{outfitId === item.id ? 'chip--selected' : ''}}" data-id="{{item.id}}" bindtap="onOutfit" hover-class="control--pressed">{{item.name}}</view></view><view wx:if="{{outfits.length < total}}" class="text-button" bindtap="onMore" hover-class="control--pressed">更多搭配</view><view wx:if="{{!outfits.length && !loading}}" class="form-hint">先保存一套自己的搭配吧</view>
  <view class="status-box status-box--warning"><image class="icon" src="/assets/icons/info.svg" mode="aspectFit" /><view>发起前，请确认<view class="status-copy">正式功能将把所选上身照和衣物图片发送给已配置的服务，并显示费用。</view></view></view><view class="consent-copy">生成图不代表真实尺码或合身程度。服务接入后，你确认照片发送范围与费用，再发起任务。</view><view class="status-box status-box--warning">{{reason}}</view><t-button t-class="ui-button" class="button-block" block="{{true}}" custom-style="display:flex;width:100%" disabled>选择照片并生成试穿</t-button><app-loading wx:if="{{loading}}" text="正在加载服务状态" /></view>
