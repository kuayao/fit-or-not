<view class="page page--tab"><view class="page-top"><view><view class="page-title">穿搭日历</view></view><button class="icon-button" theme="primary" disabled="{{!canAdd}}" bindtap="onAdd" aria-label="记录穿搭"><image class="icon" src="/assets/icons/plus.svg" mode="aspectFit" /></button></view>
  <view class="month-heading"><button class="icon-button" data-offset="-1" bindtap="onMonth" aria-label="上个月"><image class="icon" src="/assets/icons/back.svg" mode="aspectFit" /></button><view>{{title}}</view><button class="icon-button" data-offset="1" bindtap="onMonth" aria-label="下个月"><image class="icon" src="/assets/icons/arrow.svg" mode="aspectFit" /></button></view>
  <view class="calendar-grid weekdays"><view wx:for="{{weekdays}}" wx:key="*this">{{item}}</view></view><view class="calendar-grid days"><view wx:for="{{days}}" wx:key="date" class="calendar-day {{item.inMonth && item.selected ? 'calendar-day--selected' : ''}} {{item.inMonth && item.isToday ? 'calendar-day--today' : ''}}" data-date="{{item.date}}" bindtap="onDate" aria-label="{{item.date}}{{item.hasRecord ? ' 有穿搭记录' : ''}}"><text wx:if="{{item.inMonth}}">{{item.number}}</text><view wx:if="{{item.inMonth && item.hasRecord}}" class="calendar-dot" /></view></view>
  <view class="calendar-legend"><view class="legend-dot" />有穿搭记录的日子</view>
  <view class="section-head"><view class="section-title">{{selectedLabel}}</view><text class="count-note">{{records.length}} 条记录</text></view><view wx:if="{{error}}" class="error" bindtap="onRetry">{{error}} · 点击重试</view>
  <view wx:if="{{loading}}" class="state">正在加载记录…</view><view wx:for="{{records}}" wx:key="id" class="record-card" data-id="{{item.id}}" bindtap="onEdit"><view class="row row--between"><text>{{item.occasion || '日常穿着'}}</text><text class="count-note">已记录</text></view><view class="record-images"><image wx:for="{{item.images}}" wx:for-item="photo" wx:key="id" class="record-photo" src="{{photo.url}}" data-url="{{photo.url}}" binderror="onImageError" mode="aspectFit" /></view><view class="record-note">{{item.notes || '值得记住的日常穿搭。'}}</view></view><view wx:if="{{!records.length && !loading && !error}}" class="record-card form-hint">这一天还没有记录。留下穿搭，慢慢认识自己的喜好。</view><view class="section"><t-button t-class="ui-button" class="button-block" block="{{true}}" custom-style="display:flex;width:100%" theme="primary" disabled="{{!canAdd}}" bind:tap="onAdd"><image class="icon icon--small" src="/assets/icons/plus.svg" mode="aspectFit" /> {{canAdd ? '记下这一天' : '未来日期不能记录实际穿着'}}</t-button><view class="section"><t-button t-class="ui-button" class="button-block" block="{{true}}" bind:tap="onToday" custom-style="display:flex;width:100%">回到今天</t-button></view></view></view>
