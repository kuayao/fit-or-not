.recommendation-detail__canvas { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); align-items: center; gap: 18rpx; padding: 28rpx; background: var(--muted-surface); border-radius: var(--panel-radius); }
.recommendation-detail__canvas--grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.recommendation-detail__image { width: 100%; height: 360rpx; }
.recommendation-detail__canvas--grid .recommendation-detail__image { height: 270rpx; }
.recommendation-detail__name { font-size: 37rpx; font-weight: 500; margin: 32rpx 0 18rpx; overflow-wrap: anywhere; }
.recommendation-detail__reason { font-size: 26rpx; line-height: 1.8; color: var(--muted); overflow-wrap: anywhere; }
.recommendation-detail__heading { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin: 44rpx 0 24rpx; font-size: 30rpx; }
.recommendation-detail__heading text { color: var(--muted); font-size: 23rpx; }
.recommendation-detail__items { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 30rpx 24rpx; }
button.recommendation-detail__item { min-width: 0; width: 100%; margin: 0; padding: 0; border: 0; border-radius: 0; background: transparent; font-size: 26rpx; color: var(--ink); text-align: left; line-height: 1.6; overflow-wrap: anywhere; }
.recommendation-detail__item::after { border: 0; }
.recommendation-detail__photo { display: block; width: 100%; height: 310rpx; margin-bottom: 15rpx; background: var(--photo); border-radius: var(--radius); }
