<app-sheet visible="{{visible}}" title="{{title}}" bind:close="onClose">
  <view wx:if="{{loading}}" class="state">正在加载选项…</view>
  <view wx:elif="{{error}}" class="choice-error"><view class="error">{{error}}</view><t-button t-class="ui-button" block bind:tap="onRetry">重新加载</t-button></view>
  <view wx:elif="{{!items.length}}" class="state">{{emptyText}}</view>
  <scroll-view wx:else class="choice-scroll" scroll-y>
    <view class="sheet-options">
      <view wx:if="{{hint}}" class="sheet-note">{{hint}}</view>
      <button wx:for="{{items}}" wx:key="id" class="sheet-option {{value === item.id ? 'sheet-option--selected' : ''}}" data-index="{{index}}" bindtap="onSelect" hover-class="control--pressed" aria-pressed="{{value === item.id}}">
        <text class="sheet-option__name">{{item.name}}</text>
        <view class="sheet-option__check"><image wx:if="{{value === item.id}}" class="sheet-option__check-image" src="/assets/icons/check.svg" mode="aspectFit" /></view>
      </button>
    </view>
  </scroll-view>
  <view slot="footer"><slot name="footer" /></view>
</app-sheet>
