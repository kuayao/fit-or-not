.date-navigation { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-bottom: 16rpx; }
.date-navigation__title { display: flex; gap: 8rpx; }
button.date-navigation__label, button.date-today { display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: auto; min-width: 0; max-width: none; padding: 8rpx 16rpx; margin: 0; min-height: 72rpx; background: var(--muted-surface); color: var(--primary); font-size: var(--sheet-option-size); font-weight: 400; line-height: 1.5; border-radius: var(--sheet-option-radius); }
button.date-navigation__label--active { background: var(--soft); }
.date-navigation__label::after, .date-today::after, .date-day::after, .date-option::after { border: 0; }
.date-navigation__range { font-size: var(--sheet-option-size); }
.date-weekdays, .date-days { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 6rpx; text-align: center; }
.date-weekdays { margin-bottom: 12rpx; color: var(--muted); font-size: 23rpx; }
.date-days__cell { aspect-ratio: 1; min-width: 0; }
button.date-day { display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 100%; min-width: 0; max-width: none; height: 100%; margin: 0; padding: 0; font-size: 27rpx; font-weight: 400; line-height: 1; color: var(--ink); background: var(--bg); border: 1px solid transparent; border-radius: 50%; }
button.date-day--today { border-color: var(--action-line); }
button.date-day--selected { background: var(--soft); color: var(--primary); border-color: var(--action-line); }
.date-arrow--disabled { opacity: .3; }
.date-options { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--sheet-gap); }
button.date-option { display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 100%; min-width: 0; max-width: none; min-height: 84rpx; margin: 0; padding: 16rpx 12rpx; font-size: 26rpx; font-weight: 400; line-height: 1.5; color: var(--ink); background: var(--muted-surface); border: 1px solid transparent; border-radius: var(--sheet-option-radius); }
button.date-option--selected { background: var(--soft); color: var(--primary); border-color: var(--action-line); }
button.date-day--disabled, button.date-option--disabled, button.date-today--disabled { color: var(--disabled-ink); background: var(--bg); }
.date-hint { text-align: center; margin-top: 20rpx; }
.date-summary { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-bottom: 16rpx; color: var(--muted); font-size: 25rpx; }

.date-range { display: flex; align-items: center; gap: 12rpx; padding: 14rpx; margin-bottom: 24rpx; background: var(--muted-surface); border-radius: var(--radius); }
.date-range__endpoint { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 10rpx; padding: 16rpx 12rpx; border-radius: var(--choice-radius); border: 1px solid transparent; }
.date-range__endpoint--active { background: var(--bg); border-color: var(--action-line); }
.date-range__label { color: var(--muted); font-size: 22rpx; }
.date-range__value { color: var(--primary); font-size: 27rpx; font-weight: 500; }
.date-range__divider { color: var(--muted); font-size: 24rpx; }
.date-days--range { column-gap: 0; }
.date-days--range .date-days__cell { padding: 4rpx 0; box-sizing: border-box; }
.date-days__cell--range { background: var(--soft); }
.date-days__cell--start { border-top-left-radius: 50%; border-bottom-left-radius: 50%; }
.date-days__cell--end { border-top-right-radius: 50%; border-bottom-right-radius: 50%; }
.date-days--range button.date-day { background: transparent; }
.date-days--range button.date-day--selected { color: var(--bg); background: var(--primary); border-color: var(--primary); }
