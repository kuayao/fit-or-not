.sheet-options { display: flex; flex-direction: column; gap: var(--sheet-gap); width: 100%; }
.sheet-options--grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
.sheet-option, button.sheet-option { display: flex; align-items: center; gap: 20rpx; box-sizing: border-box; width: 100%; min-width: 0; max-width: none; min-height: var(--sheet-option-height); margin: 0; padding: 22rpx 24rpx; border: 1px solid transparent; border-radius: var(--sheet-option-radius); background: var(--muted-surface); color: var(--ink); font-size: var(--sheet-option-size); font-weight: 400; line-height: 1.5; text-align: left; }
.sheet-option::after { border: 0; }
.sheet-option--selected, button.sheet-option--selected { background: var(--soft); border-color: var(--action-line); color: var(--primary); }
.sheet-option__name { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.sheet-option__hint { margin-top: 6rpx; color: var(--muted); font-size: 23rpx; font-weight: 400; }
.sheet-option__check { display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 32rpx; height: 32rpx; border: 1px solid var(--action-line); border-radius: 50%; flex-shrink: 0; }
.sheet-option--selected .sheet-option__check { border-color: var(--primary); background: var(--primary); }
.sheet-option__check-image { width: 24rpx; height: 24rpx; filter: brightness(0) invert(1); }
.sheet-tags { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--sheet-gap); }
.sheet-tags--pair { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.sheet-tags--seasons { grid-template-columns: repeat(4, minmax(0, 1fr)); }
.sheet-tag { display: flex; align-items: center; justify-content: center; box-sizing: border-box; min-height: 84rpx; min-width: 0; padding: 16rpx 12rpx; border: 1px solid transparent; border-radius: var(--sheet-option-radius); background: var(--muted-surface); color: var(--ink); font-size: 26rpx; line-height: 1.5; text-align: center; overflow-wrap: anywhere; }
.sheet-tag--selected { background: var(--soft); color: var(--primary); border-color: var(--action-line); }
.sheet-link { display: flex; align-items: center; justify-content: center; min-height: 68rpx; margin: 0; padding: 8rpx 16rpx; box-sizing: border-box; border-radius: var(--sheet-option-radius); color: var(--primary); font-size: 25rpx; }
.sheet-note { margin-bottom: 20rpx; color: var(--muted); font-size: 23rpx; line-height: 1.7; }
.sheet-photo-option { position: relative; min-width: 0; padding: 8rpx; border: 1px solid transparent; border-radius: var(--sheet-option-radius); background: var(--muted-surface); overflow: hidden; }
.sheet-photo-option--selected { border-color: var(--action-line); background: var(--soft); }
.sheet-photo-option--included { opacity: .6; }
.sheet-photo-option__check { position: absolute; top: 14rpx; right: 14rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 34rpx; height: 34rpx; border: 1px solid var(--action-line); border-radius: 50%; background: var(--bg); }
.sheet-photo-option--selected .sheet-photo-option__check { background: var(--primary); border-color: var(--primary); }
.sheet-photo-option .card-meta { padding: 6rpx; overflow-wrap: anywhere; }
