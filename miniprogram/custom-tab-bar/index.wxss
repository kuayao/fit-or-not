.tab-bar { position: fixed; bottom: 0; left: 0; right: 0; z-index: 20; display: flex; align-items: center; background: var(--bg); border-top: 1px solid var(--line); padding: 16rpx 15rpx calc(20rpx + env(safe-area-inset-bottom)); }
.tab { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; padding: 2rpx 8rpx; color: var(--muted); font-size: 20rpx; gap: 8rpx; }
.tab--selected { color: var(--primary); }
.tab-icon { width: 42rpx; height: 42rpx; opacity: .55; }
.tab--selected .tab-icon { opacity: 1; }
.tab-bar .tab-add { flex-shrink: 0; width: 88rpx; min-width: 88rpx; max-width: 88rpx; height: 88rpx; margin: 0 18rpx; padding: 0; display: flex; align-items: center; justify-content: center; background: var(--primary); border: 0; border-radius: var(--radius); }
.tab-add::after { border: 0; }
.tab-add__icon { width: 46rpx; height: 46rpx; filter: brightness(0) invert(1); }
