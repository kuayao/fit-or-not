@import "styles/theme.wxss";
@import "styles/color-options.wxss";
@import "styles/sheet-options.wxss";
.page { padding: 36rpx var(--space) 54rpx; box-sizing: border-box; }
.page--tab { padding-bottom: calc(150rpx + env(safe-area-inset-bottom)); }
.page-top { display: flex; justify-content: space-between; align-items: center; gap: 23rpx; margin-bottom: 46rpx; }
.page-title { font-size: 48rpx; font-weight: 500; line-height: 1.45; letter-spacing: 1rpx; }
.subtitle { color: var(--muted); font-size: 23rpx; margin-top: 13rpx; line-height: 1.7; }
.section { margin-top: 46rpx; }
.section-title { font-size: 29rpx; font-weight: 500; margin-bottom: 25rpx; }
.section-head { display: flex; align-items: center; justify-content: space-between; margin: 35rpx 0 25rpx; gap: 16rpx; }
.section-head .section-title { margin: 0; }
.row { display: flex; align-items: center; gap: 23rpx; }
.row--between { justify-content: space-between; }
.row--wrap { flex-wrap: wrap; }
.grow { flex: 1; min-width: 0; }
.icon { width: 42rpx; height: 42rpx; flex-shrink: 0; }
.icon--small { width: 35rpx; height: 35rpx; }
.icon-button { width: 85rpx; height: 85rpx; padding: 0; margin: 0; background: transparent; display: flex; align-items: center; justify-content: center; border: 0; flex-shrink: 0; border-radius: 50%; }
.icon-button::after { border: 0; }
button.icon-button { width: 85rpx; min-width: 85rpx; max-width: 85rpx; padding: 0; margin: 0; }
.text-button { font-size: 26rpx; color: var(--primary); display: flex; align-items: center; gap: 10rpx; padding: 16rpx 12rpx; min-height: var(--touch-height); box-sizing: border-box; border-radius: 16rpx; }
.text-button--center { justify-content: center; margin: 26rpx auto; }
.count-note { font-size: 21rpx; color: var(--muted); }
.page-caption { font-size: 29rpx; margin: -6rpx 0 27rpx; min-height: 44rpx; }
.search-row { display: flex; gap: 17rpx; margin-bottom: 35rpx; }
.search { background: var(--muted-surface); border-radius: 19rpx; padding: 0 23rpx; height: 85rpx; flex: 1; min-width: 0; display: flex; align-items: center; gap: 15rpx; }
.search .input { font-size: 25rpx; min-height: 60rpx; width: 100%; }
.filter-button { width: 85rpx; height: 85rpx; display: flex; justify-content: center; align-items: center; }
.input { font-size: var(--text-size); color: var(--ink); min-height: 64rpx; box-sizing: border-box; }
.field { margin: 36rpx 0; }
.field-label { font-size: 23rpx; color: var(--muted); margin-bottom: 15rpx; }
.field .input, .field .textarea, .field .choice-value { width: 100%; background: var(--bg); border: 1px solid var(--choice-border); border-radius: var(--choice-radius); padding: 20rpx 23rpx; min-height: 87rpx; box-sizing: border-box; font-size: var(--choice-font-size); }
.textarea { width: 100%; height: 180rpx; min-height: 150rpx; font-size: var(--text-size); box-sizing: border-box; }
.field-pair { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 23rpx; }
.field-pair .field { margin: 23rpx 0; }
.chips { display: flex; flex-wrap: wrap; gap: 14rpx; }
.chip { min-height: 76rpx; display: inline-flex; align-items: center; box-sizing: border-box; padding: 12rpx 19rpx; border: 1px solid var(--line); border-radius: 12rpx; font-size: 23rpx; background: var(--bg); color: var(--muted); }
.chip--selected { color: var(--primary); background: var(--soft); border-color: var(--action-line); }
.category-scroll { width: 100%; white-space: nowrap; border-bottom: 1px solid var(--line); margin-bottom: 36rpx; }
.category-row { display: flex; gap: 21rpx; }
.category-row .chip { flex-shrink: 0; position: relative; border: 0; border-radius: 0; background: transparent; padding: 23rpx 19rpx; min-height: 85rpx; box-sizing: border-box; }
.category-row .chip--selected::after { content: ''; position: absolute; bottom: 0; left: 19rpx; width: 34rpx; height: 3rpx; background: var(--accent); }
.grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 48rpx 27rpx; }
.card-image { width: 100%; aspect-ratio: 10 / 11; background: var(--photo); border-radius: var(--radius); display: block; }
.clothing-visual { position: relative; aspect-ratio: 10 / 11; background: var(--photo); border-radius: var(--radius); overflow: hidden; display: flex; align-items: center; justify-content: center; }
.clothing-visual .garment { width: 86%; height: 86%; }
.clothing-card { position: relative; min-width: 0; }
button.heart-button { position: absolute; right: 13rpx; top: 13rpx; width: 58rpx; min-width: 58rpx; max-width: 58rpx; height: 58rpx; }
.heart-button .icon { width: 29rpx; height: 29rpx; }
.heart-button--selected { background: var(--soft); }
.card-name { margin: 21rpx 2rpx 9rpx; font-size: 24rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.card-meta { color: var(--muted); font-size: 21rpx; }
.label-dot { display: inline-block; width: 13rpx; height: 13rpx; border-radius: 50%; background: #C9C7BD; margin-right: 10rpx; }
.state { padding: 62rpx 24rpx; text-align: center; color: var(--muted); font-size: 23rpx; }
.empty-state { text-align: center; padding: 110rpx 35rpx; }
.empty-state .empty-icon { display: block; width: 87rpx; height: 87rpx; margin: 0 auto 42rpx; opacity: .6; }
.empty-title { font-size: 36rpx; font-weight: 500; }
.empty-copy { font-size: 23rpx; line-height: 1.8; color: var(--muted); margin: 23rpx 0 44rpx; }
.error { color: var(--danger); background: #FCF4F3; padding: 23rpx 25rpx; border-radius: 19rpx; margin: 30rpx 0; font-size: 23rpx; }
.notice { background: var(--soft); padding: 23rpx 25rpx; border-radius: 19rpx; font-size: 23rpx; color: var(--primary); line-height: 1.7; }
.status-box { display: flex; gap: 19rpx; padding: 23rpx 25rpx; background: var(--soft); border-radius: 19rpx; margin: 31rpx 0; font-size: 23rpx; line-height: 1.7; }
.status-copy { font-size: 21rpx; color: var(--muted); margin-top: 4rpx; }
.status-box--warning { background: #FAF7F0; color: #79623C; }
.actions { display: flex; gap: 19rpx; margin-top: 35rpx; }
.actions > t-button { flex: 1; }
.danger { color: var(--danger); }
.form-hint { font-size: 21rpx; line-height: 1.7; color: var(--muted); }
.form-actions { text-align: center; margin-top: 35rpx; }
.form-actions .form-hint { margin-top: 19rpx; }
.full-image { width: 100%; height: 542rpx; background: var(--photo); border-radius: 31rpx; }
.detail-hero { height: 542rpx; border-radius: 31rpx; background: var(--photo); display: flex; align-items: center; justify-content: center; position: relative; }
.detail-hero .garment { width: 94%; height: 94%; }
.mini-badge { display: inline-flex; align-items: center; gap: 8rpx; font-size: 19rpx; padding: 8rpx 13rpx; border-radius: 12rpx; background: var(--soft); color: var(--primary); }
.detail-hero .mini-badge { position: absolute; left: 27rpx; bottom: 27rpx; background: #FFFFFFDD; }
.mini-badge .icon { width: 29rpx; height: 29rpx; }
.detail-title { margin-top: 38rpx; display: flex; justify-content: space-between; align-items: flex-start; gap: 19rpx; }
.detail-name { font-size: 42rpx; font-weight: 500; line-height: 1.5; }
.tag-row { display: flex; flex-wrap: wrap; gap: 13rpx; margin: 27rpx 0; }
.soft-tag { padding: 11rpx 19rpx; font-size: 21rpx; border-radius: 12rpx; background: var(--muted-surface); color: var(--muted); }
.stats-inline { display: flex; padding: 35rpx 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); margin: 38rpx 0; }
.stats-inline__item { flex: 1; min-width: 0; }
.stats-inline__value { font-size: 42rpx; font-weight: 500; overflow-wrap: anywhere; }
.stats-inline__label { font-size: 21rpx; color: var(--muted); margin-top: 11rpx; }
.info-list { display: flex; flex-direction: column; gap: 25rpx; margin: 35rpx 0; }
.info-line { display: flex; justify-content: space-between; font-size: 23rpx; gap: 38rpx; }
.info-label { color: var(--muted); flex-shrink: 0; }
.list-item { padding: 27rpx 0; border-bottom: 1px solid var(--line); }
.thumb { width: 102rpx; height: 108rpx; border-radius: 19rpx; background: var(--photo); flex-shrink: 0; }
.bottom-action { position: sticky; bottom: 0; background: var(--bg); padding: 19rpx 0 calc(19rpx + env(safe-area-inset-bottom)); margin-top: 30rpx; z-index: 10; }
.choice-value { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; min-width: 0; }
.choice-value__text { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.field .choice-value--disabled { color: var(--disabled-ink); background: var(--muted-surface); }
.stats-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 23rpx; margin: 38rpx 0; }
.stat-card { background: var(--muted-surface); padding: 33rpx; border-radius: var(--radius); }
.stat-card--accent { background: var(--soft); color: var(--primary); }
.stat-value { font-size: 50rpx; line-height: 1.3; margin-bottom: 15rpx; overflow-wrap: anywhere; }
.stat-label { color: var(--muted); font-size: 21rpx; }
.menu-list { margin: 33rpx 0; }
.menu-row { display: flex; align-items: center; gap: 23rpx; padding: 31rpx 0; border-bottom: 1px solid var(--line); font-size: 25rpx; }
.menu-row:last-child { border: 0; }
.menu-row .subtitle { font-size: 21rpx; margin-top: 11rpx; }
.eyebrow { font-size: 19rpx; letter-spacing: 4rpx; color: var(--muted); }
.skeleton-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 27rpx; }
.skeleton { height: 366rpx; border-radius: 31rpx; background: #F1F4F7; }
.skeleton-line { height: 23rpx; background: #F1F4F7; border-radius: 10rpx; margin: 23rpx 0; width: 75%; }

.button-block { display: block; width: 100%; min-width: 0; }
.page-top > .icon-button { margin-left: auto; margin-right: 0; }

.control--pressed { background: var(--pressed); opacity: .8; }
.entry-row { display: flex; align-items: center; gap: 18rpx; min-height: 100rpx; padding: 20rpx 24rpx; box-sizing: border-box; background: var(--muted-surface); border: 1px solid var(--action-line); border-radius: var(--radius); color: var(--primary); font-size: 27rpx; margin: 24rpx 0; }
.sheet-actions { display: flex; flex-direction: column; gap: 20rpx; }
.sheet-photo-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 18rpx; }
.sheet-photo-grid .thumb { width: 100%; height: 180rpx; }
.segmented { display: flex; gap: 8rpx; background: var(--muted-surface); padding: 8rpx; border-radius: var(--radius); margin: 24rpx 0; }
.segmented__option { flex: 1; text-align: center; min-height: var(--touch-height); display: flex; align-items: center; justify-content: center; padding: 12rpx; box-sizing: border-box; color: var(--muted); font-size: 25rpx; border: 1px solid transparent; border-radius: 18rpx; }
.segmented__option--selected { color: var(--primary); background: var(--bg); border-color: var(--action-line); font-weight: 500; }

.ui-button { border: 1px solid var(--action-line); }
.ui-button--danger { border-color: #E2BCB8; background: #FDF7F6; color: var(--danger); }
.ui-button--danger::after { border: 0; }
.sheet-actions > t-button { display: block; width: 100%; }

.packing-date-range { display: flex; align-items: center; gap: 16rpx; padding: 24rpx; border: 1px solid var(--action-line); border-radius: var(--choice-radius); background: var(--soft); }
.packing-date-range__endpoint { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 14rpx; }
.packing-date-range__label { font-size: 22rpx; color: var(--muted); }
.packing-date-range__value { font-size: 26rpx; color: var(--primary); overflow-wrap: anywhere; }
.packing-date-range__arrow { width: 24rpx; height: 24rpx; flex-shrink: 0; }
.packing-date-range__icon { width: 32rpx; height: 32rpx; flex-shrink: 0; }
