NODE_ENV=development
HOST=127.0.0.1
PORT=3006
# 可信反向代理 IP/CIDR，英文逗号分隔；直连时留空。
TRUST_PROXY=
DB_HOST=127.0.0.1
DB_PORT=55436
DB_NAME=fit_or_not
DB_USER=fit_or_not
DB_PASSWORD=local-fit-or-not-only
MEDIA_DIR=.local/media
PUBLIC_BASE_URL=http://127.0.0.1:3006
MEDIA_SIGNING_KEY=replace-with-at-least-32-random-characters
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 出行提醒模板：thing1 行程名称、time8 出发时间、thing6 出行清单。
WECHAT_PACKING_TEMPLATE_ID=
# 消息跳转版本：developer / trial / formal。
WECHAT_MESSAGE_ENV=formal
MEMBER_LIMIT=3
# 高德 Web 服务 API 类型的 Key。
AMAP_KEY=

NEW_API_BASE_URL=https://newapi.ammmm.us/v1
NEW_API_KEY=
AI_RECOGNITION_MODEL=gpt-6-luna
AI_RECOMMENDATION_MODEL=gpt-6-luna
AI_RECOMMENDATION_TIMEOUT_MS=45000
AI_CUTOUT_MODEL=gpt-image-2.6-flare
AI_CUTOUT_QUALITY=low
AI_CUTOUT_COMPLEXITY=low
AI_RECOGNITION_TIMEOUT_MS=60000
AI_CUTOUT_TIMEOUT_MS=180000
# 接口返回图片 URL 时，仅允许下载这里配置的 HTTPS 域名；多个用英文逗号分隔。
AI_IMAGE_DOWNLOAD_HOSTS=
